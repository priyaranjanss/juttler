# ---------------------------------------------------------------------------
# Copy this file to frontend/.env
#
# The URL of the backend API server. The frontend is deployed independently and
# talks to the backend purely over this URL — it is read at BUILD time by Vite,
# so a redeploy of the backend alone only needs a frontend rebuild if this
# value changes.
#
# The backend must allow this origin: that's what FRONTEND_URL in backend/.env
# is for. The two must match.
#
# Vite only exposes variables prefixed with VITE_ to the browser.
# ---------------------------------------------------------------------------

# Development — point at the local backend (npm run dev in backend/)
VITE_BACKEND_URL=http://localhost:3000

# Production — the deployed backend origin, e.g.
#   VITE_BACKEND_URL=https://your-backend.up.railway.app
#
# Set this as a Railway build variable so it is baked into the static bundle.
