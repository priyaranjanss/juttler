# ---------------------------------------------------------------------------
# Copy this file to frontend/.env
#
# The URL of the backend API server. The frontend calls it directly, so the
# backend must allow this origin — that's what FRONTEND_URL in backend/.env
# is for.
#
# Vite only exposes variables prefixed with VITE_ to the browser.
# ---------------------------------------------------------------------------

# Development — point at the local backend (npm run dev:backend)
VITE_BACKEND_URL=http://localhost:3000

# Production builds: set this to your deployed API origin, e.g.
#   VITE_BACKEND_URL=https://api.yourdomain.com
# or leave it empty ("") for same-origin, when the backend itself serves the
# built frontend (the app then calls /api on its own origin).
