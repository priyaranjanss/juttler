{
  "name": "juttler-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --exec tsx src/server.ts",
    "start": "tsx db/migrate.ts && tsx src/server.ts",
    "db:migrate": "tsx db/migrate.ts",
    "db:clean": "tsx db/clean.ts",
    "seed:admin": "tsx db/seed-admin.ts",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/services/slackTeam/decide.test.ts src/services/workScope.test.ts src/services/embeddedToolCalls.test.ts src/services/slackFormat.test.ts src/services/toolArgSanitize.test.ts src/services/issueKeys.test.ts src/plugins/jira/jql.test.ts src/plugins/github/edit.test.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.77",
    "@neondatabase/serverless": "^1.2.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@upstash/redis": "^1.39.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "nodemon": "^3.0.1",
    "typescript": "^7.0.2"
  }
}
