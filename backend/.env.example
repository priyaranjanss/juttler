# Neon (rewritten by: neon env pull --file backend/.env)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# App
FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:3000
JWT_SECRET=
CREDENTIAL_SECRET=

# Gmail OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional; token paste works without these)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Jira OAuth (optional). Add PUBLIC_BACKEND_URL/api/plugins/jira/callback as the
# Atlassian OAuth 2.0 (3LO) callback URL.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Slack plugin OAuth + per-bot apps
SLACK_OAUTH_BASE_URL=http://localhost:3000
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CONFIG_TOKEN=

# Optional: shared OAuth state across restarts
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
