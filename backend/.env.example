# Juttler backend environment — the ONLY env file the backend reads.
#
# The first three lines (DATABASE_URL*) are maintained by the Neon CLI:
#   neon env pull --file backend/.env
# (only Neon lines are touched; your other keys are preserved)

DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Per-bot AI configuration (provider, model, API key) is set in the UI —
# open a bot's settings and use the AI panel there. Nothing AI-related is
# read from this file. See https://kilo.ai/docs/gateway/api-reference

# Encrypts plugin credentials (GitHub/Jira/Slack tokens) at rest. Required in
# production; rotating it makes existing plugin connections unusable until the
# user reconnects each one.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CREDENTIAL_SECRET=

# --- Optional OAuth apps (only needed to use the OAuth connect flow) ---
# Every plugin can also be connected by pasting an access token, except Gmail,
# which is OAuth-only.
# GitHub OAuth app -> https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client (Gmail) -> https://console.cloud.google.com/apis/credentials
#   Scopes are requested automatically (gmail.readonly + gmail.send).
#   The redirect URI you register is PUBLIC_BACKEND_URL + the path below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- How the two services talk (frontend and backend deploy independently) ---

# If you use OAuth plugins, also set PUBLIC_BACKEND_URL to this backend's
# public domain (e.g. https://your-backend.up.railway.app). It feeds the
# provider callback URLs only; the server refuses an OAuth start without
# it in production rather than redirecting to localhost.

# URL of the frontend app. Used for CORS and as the OAuth landing page. This is
# the backend's only link to the frontend.
#   dev:      http://localhost:5173
#   deployed: https://your-frontend.up.railway.app   (no trailing slash)
FRONTEND_URL=http://localhost:5173

